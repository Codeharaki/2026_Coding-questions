class Solution {
    public int numDecodings(String s) {
        if (s.charAt(0) == '0') {
            return 0;
        }

        int twoBack = 1;
        int oneBack = 1;

        for (int i = 1; i < s.length(); i++) {
            int ways = 0;
            if (s.charAt(i) != '0') {
                ways += oneBack;
            }

            int pair = (s.charAt(i - 1) - '0') * 10 + (s.charAt(i) - '0');
            if (pair >= 10 && pair <= 26) {
                ways += twoBack;
            }

            twoBack = oneBack;
            oneBack = ways;
        }

        return oneBack;
    }
}

/*
Time:  O(n)
Space: O(1)

Count valid one-digit and two-digit decodings ending at each position.
*/