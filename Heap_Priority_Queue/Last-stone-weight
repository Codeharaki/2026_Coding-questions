class Solution {
    public int lastStoneWeight(int[] stones) {
        PriorityQueue<Integer> heaviestFirst = new PriorityQueue<>(Collections.reverseOrder());
        for (int stone : stones) {
            heaviestFirst.offer(stone);
        }

        while (heaviestFirst.size() > 1) {
            int first = heaviestFirst.poll();
            int second = heaviestFirst.poll();
            if (first != second) {
                heaviestFirst.offer(first - second);
            }
        }

        return heaviestFirst.isEmpty() ? 0 : heaviestFirst.peek();
    }
}

/*
Time:  O(n log n)
Space: O(n)

Repeatedly remove the two heaviest stones and reinsert their difference.
*/