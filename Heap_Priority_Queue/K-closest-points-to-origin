class Solution {
    public int[][] kClosest(int[][] points, int k) {
        PriorityQueue<int[]> farthestFirst = new PriorityQueue<>(
                (a, b) -> Integer.compare(distanceSquared(b), distanceSquared(a)));

        for (int[] point : points) {
            farthestFirst.offer(point);
            if (farthestFirst.size() > k) {
                farthestFirst.poll();
            }
        }

        int[][] result = new int[k][2];
        for (int i = 0; i < k; i++) {
            result[i] = farthestFirst.poll();
        }
        return result;
    }

    private int distanceSquared(int[] point) {
        return point[0] * point[0] + point[1] * point[1];
    }
}

/*
Time:  O(n log k)
Space: O(k)

Keep a max-heap of the k closest points seen so far.
*/