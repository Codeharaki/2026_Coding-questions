class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int left = 1;
        int right = 0;

        for (int pile : piles) {
            right = Math.max(right, pile);
        }

        while (left < right) {
            int speed = left + (right - left) / 2;
            long hours = 0;

            for (int pile : piles) {
                hours += (pile + (long) speed - 1) / speed;
            }

            if (hours <= h) {
                right = speed;
            } else {
                left = speed + 1;
            }
        }

        return left;
    }
}

/*
Time:  O(n log m), where m is the largest pile
Space: O(1)

Binary search the smallest speed that lets Koko finish within h hours.
*/